// ============================================================
// PharmaCare — Complete Prisma Schema
// Covers all 20 modules with proper relationships
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// MODULE 1 & 2: AUTH, USERS & ROLES
// ─────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  phone              String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mfaEnabled         Boolean   @default(false)
  totpSecret         String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App relations
  userRoles             UserRole[]
  branch                Branch?              @relation(fields: [branchId], references: [id])
  branchId              String?
  createdProducts       Product[]            @relation("ProductCreatedBy")
  approvedPrescriptions Prescription[]       @relation("PrescriptionApprovedBy")
  auditLogs             AuditLog[]
  notifications         Notification[]
  passwordResetTokens   PasswordResetToken[]
  passwordHistories     PasswordHistory[]
  salesCreated          Sale[]               @relation("SaleCreatedBy")
  purchasesCreated      Purchase[]           @relation("PurchaseCreatedBy")
  stockAdjustments      StockAdjustment[]    @relation("AdjustmentCreatedBy")
  ScheduleH1Register    ScheduleH1Register[]
  NarcoticRegister      NarcoticRegister[]

  @@map("users")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_histories")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "products:create", "sales:void"
  name        String
  description String?
  module      String // e.g., "products", "sales"
  action      String // e.g., "create", "read", "update", "delete"
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────
// MODULE 3: ORGANIZATION MANAGEMENT
// ─────────────────────────────────────────────────────────────

model Organization {
  id                 String   @id @default(cuid())
  name               String
  legalName          String?
  gstin              String?  @unique
  pan                String?
  dlNumber           String? // Drug License number
  email              String?
  phone              String?
  website            String?
  logoUrl            String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  country            String   @default("India")
  currency           String   @default("INR")
  timezone           String   @default("Asia/Kolkata")
  financialYearStart Int      @default(4) // April = 4
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branches Branch[]
  settings OrganizationSetting[]
  Doctor   Doctor[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  gstin          String?
  dlNumber       String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  isHeadOffice   Boolean  @default(false)
  isActive       Boolean  @default(true)
  invoicePrefix  String   @default("INV")
  invoiceCounter Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id])
  users            User[]
  inventory        Inventory[]
  sales            Sale[]
  purchases        Purchase[]
  walls            Wall[]
  NarcoticRegister NarcoticRegister[]

  @@unique([organizationId, code])
  @@map("branches")
}

model OrganizationSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("organization_settings")
}

// ─────────────────────────────────────────────────────────────
// MODULE 3B: STORE / RACK MANAGEMENT
// Wall → Rack → RackShelf → StoreBin → BinStock
// ─────────────────────────────────────────────────────────────

enum WallType {
  OPEN // Standard open shelving
  REFRIGERATED // +2°C to +8°C cold chain
  COLD_CHAIN // Deep freeze -25°C to -15°C
  CONTROLLED_ACCESS // Schedule H / Narcotic controlled access
}

/// A physical wall or zone within the store/branch.
/// Each branch can have multiple walls (e.g., Wall A, Wall B, Refrigerated Zone).
model Wall {
  id          String   @id @default(cuid())
  branchId    String
  code        String // Short code, e.g. "A", "B", "REF"
  name        String // Full descriptive name, e.g. "Wall A – Antibiotics"
  description String?
  wallType    WallType @default(OPEN)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  racks  Rack[]

  @@unique([branchId, code])
  @@index([branchId])
  @@map("walls")
}

/// A physical rack attached to a wall.
/// e.g., Rack code "A-03" on Wall A.
model Rack {
  id          String   @id @default(cuid())
  wallId      String
  code        String // e.g. "A-03" (full rack code including wall prefix)
  name        String? // e.g. "Rack 3"
  description String?
  capacity    Int? // Max number of shelves
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wall     Wall        @relation(fields: [wallId], references: [id], onDelete: Cascade)
  shelves  RackShelf[]
  // Legacy product references (kept for backwards compat during migration)
  products Product[]

  @@unique([wallId, code])
  @@index([wallId])
  @@map("racks")
}

/// A shelf (level) within a rack.
/// e.g., Shelf level 1, 2, 3 on Rack A-03.
model RackShelf {
  id          String   @id @default(cuid())
  rackId      String
  level       Int // 1-indexed shelf level from bottom
  label       String? // e.g. "Top", "Middle", "Bottom" or null
  description String?
  maxBins     Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  rack Rack       @relation(fields: [rackId], references: [id], onDelete: Cascade)
  bins StoreBin[]

  @@unique([rackId, level])
  @@index([rackId])
  @@map("rack_shelves")
}

/// A storage bin — the smallest physical unit within a shelf.
/// e.g., Bin "B" on Shelf 2 of Rack A-03 on Wall A → full address "A-03-2-B"
model StoreBin {
  id          String   @id @default(cuid())
  shelfId     String
  binCode     String // Short code, e.g. "A", "B", "C"
  fullAddress String // Computed: "wall-rack-shelf-bin", e.g. "A-03-2-B"
  capacity    Int? // Max units (strips/bottles) that fit
  currentFill Int      @default(0) // Derived / cached fill count
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shelf    RackShelf  @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  stock    BinStock[]
  products Product[]  @relation("ProductPrimaryBin")

  @@unique([shelfId, binCode])
  @@index([shelfId])
  @@index([fullAddress])
  @@map("store_bins")
}

/// Tracks how many units of a specific batch sit in a specific bin.
/// One row per (bin, product, batch) combination.
model BinStock {
  id          String   @id @default(cuid())
  binId       String
  productId   String
  batchId     String? // Nullable for bulk/non-batch items
  quantity    Int      @default(0)
  reservedQty Int      @default(0) // Reserved for pending sales
  placedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  placedById  String? // User who placed it

  bin     StoreBin @relation(fields: [binId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  batch   Batch?   @relation(fields: [batchId], references: [id])

  @@unique([binId, productId, batchId])
  @@index([binId])
  @@index([productId])
  @@index([batchId])
  @@map("bin_stocks")
}

// ─────────────────────────────────────────────────────────────
// MODULE 4: PRODUCT MASTER MANAGEMENT
// ─────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@map("categories")
}

model Product {
  id                     String            @id @default(cuid())
  name                   String
  genericName            String?
  sku                    String            @unique
  barcode                String?           @unique
  description            String?           @db.Text
  manufacturer           String?
  composition            String?           @db.Text
  drugSchedule           DrugSchedule      @default(NONE)
  storageCondition       StorageCondition?
  isPrescriptionRequired Boolean           @default(false)
  unitOfMeasure          String            @default("Strip")
  tabsPerStrip           Int?
  packSize               String? // e.g., "10 tablets", "100ml"
  hsnCode                String?
  dpcoCeiling            Decimal?          @db.Decimal(10, 2)
  gstRate                Decimal           @default(12.00) @db.Decimal(5, 2)
  cgstRate               Decimal           @default(6.00) @db.Decimal(5, 2)
  sgstRate               Decimal           @default(6.00) @db.Decimal(5, 2)
  igstRate               Decimal           @default(12.00) @db.Decimal(5, 2)
  isGstExempt            Boolean           @default(false)
  mrp                    Decimal           @db.Decimal(12, 2)
  ptr                    Decimal?          @db.Decimal(12, 2) // Price to retailer
  pts                    Decimal?          @db.Decimal(12, 2) // Price to stockist
  costPrice              Decimal?          @db.Decimal(12, 2)
  rackId                 String? // Legacy: kept for backwards compat
  primaryBinId           String? // New: FK to StoreBin (primary location)
  minStockLevel          Int               @default(10)
  maxStockLevel          Int?
  reorderLevel           Int               @default(20)
  imageUrl               String?
  isActive               Boolean           @default(true)
  isReturnable           Boolean           @default(true)
  createdById            String
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  createdBy          User                 @relation("ProductCreatedBy", fields: [createdById], references: [id])
  categories         ProductCategory[]
  barcodes           ProductBarcode[]
  inventory          Inventory[]
  batches            Batch[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  hsnCodeRef         HsnCode?             @relation(fields: [hsnCode], references: [code])
  rack               Rack?                @relation(fields: [rackId], references: [id])
  primaryBin         StoreBin?            @relation("ProductPrimaryBin", fields: [primaryBinId], references: [id])
  binStocks          BinStock[]
  ScheduleH1Register ScheduleH1Register[]
  NarcoticRegister   NarcoticRegister[]

  @@index([name])
  @@index([genericName])
  @@index([barcode])
  @@index([sku])
  @@index([drugSchedule])
  @@index([rackId])
  @@index([primaryBinId])
  @@map("products")
}

enum DrugSchedule {
  NONE
  H // Prescription required
  H1 // Controlled
  X // Special prescription
  G // OTC warning
  J // Exempt
  NARCOTIC_NDPS
}

enum StorageCondition {
  DEEP_FREEZE // Deep Freeze -25°C to -15°C
  REFRIGERATED // Refrigerated +2°C to +8°C
  COOL // Cool +8°C to +15°C
  ROOM_TEMPERATURE // Room Temperature +15°C to +25°C
  CONTROLLED_ROOM_TEMP // Controlled Room Temp +20°C to +25°C
}

model ProductCategory {
  id         String @id @default(cuid())
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_categories")
}

model ProductBarcode {
  id        String   @id @default(cuid())
  productId String
  barcode   String   @unique
  type      String   @default("EAN13")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_barcodes")
}

// ─────────────────────────────────────────────────────────────
// MODULE 5 & 6: INVENTORY & BATCH MANAGEMENT
// ─────────────────────────────────────────────────────────────

model Inventory {
  id                String   @id @default(cuid())
  productId         String
  branchId          String
  totalQuantity     Int      @default(0)
  reservedQuantity  Int      @default(0)
  availableQuantity Int      @default(0) // totalQuantity - reservedQuantity
  updatedAt         DateTime @updatedAt

  product   Product             @relation(fields: [productId], references: [id])
  branch    Branch              @relation(fields: [branchId], references: [id])
  movements InventoryMovement[]

  @@unique([productId, branchId])
  @@map("inventory")
}

model InventoryMovement {
  id             String       @id @default(cuid())
  inventoryId    String
  type           MovementType
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  referenceType  String? // "SALE", "PURCHASE", "ADJUSTMENT", "RETURN"
  referenceId    String?
  batchId        String?
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  batch     Batch?    @relation(fields: [batchId], references: [id])

  @@index([inventoryId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

enum MovementType {
  IN // Stock in
  OUT // Stock out
  ADJUSTMENT // Manual adjustment
  RETURN_IN // Customer return - back to stock
  RETURN_OUT // Supplier return
  TRANSFER // Branch transfer
  WRITE_OFF // Expired/damaged write-off
}

model StockAdjustment {
  id             String                  @id @default(cuid())
  branchId       String
  productId      String
  batchId        String?
  adjustmentType AdjustmentType
  quantity       Int // positive = add, negative = remove
  reason         String
  notes          String?                 @db.Text
  status         AdjustmentStatus        @default(PENDING)
  requiredTier   AdjustmentApprovalTier?
  evidenceFileId String?
  approvedById   String?
  approvedAt     DateTime?
  createdById    String
  createdAt      DateTime                @default(now())

  createdBy    User  @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  evidenceFile File? @relation("AdjustmentEvidence", fields: [evidenceFileId], references: [id])

  @@index([branchId, productId])
  @@index([evidenceFileId])
  @@map("stock_adjustments")
}

enum AdjustmentType {
  PHYSICAL_COUNT // Actual count differs from system
  DAMAGE // Damaged goods write-off
  THEFT // Theft/loss write-off
  EXPIRY // Expired goods
  CORRECTION // Data correction
  OPENING_STOCK // Opening balance entry
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdjustmentApprovalTier {
  SELF
  MANAGER
  CHIEF
}

model Batch {
  id                String      @id @default(cuid())
  productId         String
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime
  dpcoCeiling       Decimal?    @db.Decimal(10, 2)
  purchasePrice     Decimal     @db.Decimal(12, 2)
  ptr               Decimal?    @db.Decimal(12, 2)
  pts               Decimal?    @db.Decimal(12, 2)
  mrp               Decimal     @db.Decimal(12, 2)
  quantity          Int         @default(0)
  reservedQuantity  Int         @default(0)
  soldQuantity      Int         @default(0)
  status            BatchStatus @default(ACTIVE)
  blockedReason     String?
  supplierRef       String?
  purchaseId        String?
  branchId          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  product            Product              @relation(fields: [productId], references: [id])
  purchase           Purchase?            @relation(fields: [purchaseId], references: [id])
  statusLogs         BatchStatusLog[]
  saleItemBatches    SaleItemBatch[]
  disposals          BatchDisposal[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  ScheduleH1Register ScheduleH1Register[]
  binStocks          BinStock[]

  @@unique([productId, batchNumber])
  @@index([productId, expiryDate])
  @@index([expiryDate])
  @@map("batches")
}

enum BatchStatus {
  ACTIVE
  BLOCKED // Quarantined
  EXPIRED
  DISPOSED
  EXHAUSTED // Quantity = 0
}

model BatchStatusLog {
  id          String      @id @default(cuid())
  batchId     String
  fromStatus  BatchStatus
  toStatus    BatchStatus
  reason      String?
  changedById String?
  createdAt   DateTime    @default(now())

  batch Batch @relation(fields: [batchId], references: [id])

  @@map("batch_status_log")
}

model BatchDisposal {
  id           String         @id @default(cuid())
  batchId      String
  quantity     Int
  reason       DisposalReason
  notes        String?        @db.Text
  disposedById String
  createdAt    DateTime       @default(now())

  batch Batch @relation(fields: [batchId], references: [id])

  @@map("batch_disposals")
}

enum DisposalReason {
  EXPIRED
  DAMAGED
  RECALLED
  CONTAMINATED
  OTHER
}

// ─────────────────────────────────────────────────────────────
// MODULE 7: POINT OF SALE (POS)
// ─────────────────────────────────────────────────────────────

model Sale {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique
  branchId           String
  customerId         String?
  prescriptionId     String?
  saleDate           DateTime      @default(now())
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent    Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  cgstAmount         Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount         Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount         Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  amountPaid         Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue         Decimal       @default(0) @db.Decimal(12, 2)
  status             SaleStatus    @default(COMPLETED)
  paymentStatus      PaymentStatus @default(PAID)
  doctorName         String?
  notes              String?
  upiQrData          String?
  thermalSlipPrinted Boolean       @default(false)
  createdById        String
  cancelledAt        DateTime?
  cancelledReason    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  branch             Branch               @relation(fields: [branchId], references: [id])
  customer           Customer?            @relation(fields: [customerId], references: [id])
  prescription       Prescription?        @relation(fields: [prescriptionId], references: [id])
  createdBy          User                 @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items              SaleItem[]
  payments           Payment[]
  returns            SaleReturn[]
  ScheduleH1Register ScheduleH1Register[]

  @@index([invoiceNumber])
  @@index([branchId, saleDate])
  @@index([customerId])
  @@map("sales")
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  PARTIALLY_RETURNED
  FULLY_RETURNED
}

enum PaymentStatus {
  PAID
  PARTIAL
  CREDIT
  OVERPAID
}

model SaleItem {
  id               String   @id @default(cuid())
  saleId           String
  productId        String
  productName      String // Snapshot at time of sale
  productSku       String
  quantity         Int
  billedUnits      Int      @default(0)
  looseUnits       Int      @default(0)
  totalBaseQty     Int      @default(0)
  unitPrice        Decimal  @db.Decimal(12, 2)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(12, 2)
  taxPercent       Decimal  @default(0) @db.Decimal(5, 2)
  cgstPercent      Decimal  @default(0) @db.Decimal(5, 2)
  sgstPercent      Decimal  @default(0) @db.Decimal(5, 2)
  igstPercent      Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal  @db.Decimal(12, 2)
  mrp              Decimal  @db.Decimal(12, 2)
  hsnCode          String?
  returnedQuantity Int      @default(0)
  createdAt        DateTime @default(now())

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  itemBatches SaleItemBatch[]
  returnItems SaleReturnItem[]

  @@map("sale_items")
}

model SaleItemBatch {
  id         String  @id @default(cuid())
  saleItemId String
  batchId    String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)

  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@map("sale_item_batches")
}

model Payment {
  id          String        @id @default(cuid())
  saleId      String?
  customerId  String?
  supplierId  String?
  purchaseId  String?
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  reference   String? // UPI ref, card last 4, cheque number
  notes       String?
  paymentDate DateTime      @default(now())
  createdAt   DateTime      @default(now())

  sale     Sale?     @relation(fields: [saleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NETBANKING
  CHEQUE
  CREDIT // Customer credit
  WALLET
}

model HeldBill {
  id         String   @id @default(cuid())
  branchId   String
  userId     String
  label      String?
  cartData   Json // Serialized cart state
  customerId String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime // Auto-delete after 24h

  @@index([branchId, userId])
  @@map("held_bills")
}

// ─────────────────────────────────────────────────────────────
// MODULE 8: PRESCRIPTION MANAGEMENT
// ─────────────────────────────────────────────────────────────

model Prescription {
  id                 String             @id @default(cuid())
  prescriptionNumber String?
  patientName        String
  patientAge         Int?
  patientPhone       String?
  doctorId           String?
  doctorName         String?
  doctorRegNumber    String?
  prescriptionDate   DateTime?
  notes              String?            @db.Text
  status             PrescriptionStatus @default(PENDING)
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  customerId         String?
  branchId           String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer   Customer?           @relation("PrescriptionCustomer", fields: [customerId], references: [id])
  pharmacist User?               @relation("PrescriptionApprovedBy", fields: [approvedById], references: [id])
  doctor     Doctor?             @relation(fields: [doctorId], references: [id])
  images     PrescriptionImage[]
  sales      Sale[]

  @@map("prescriptions")
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
  DISPENSED
  EXPIRED
}

model PrescriptionImage {
  id             String   @id @default(cuid())
  prescriptionId String
  fileUrl        String
  fileName       String
  fileSize       Int
  mimeType       String
  uploadedAt     DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_images")
}

// ─────────────────────────────────────────────────────────────
// MODULE 9: PURCHASE MANAGEMENT
// ─────────────────────────────────────────────────────────────

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  branchId       String
  supplierId     String
  invoiceNumber  String? // Supplier's invoice number
  invoiceDate    DateTime?
  purchaseDate   DateTime       @default(now())
  expectedDate   DateTime?
  status         PurchaseStatus @default(DRAFT)
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal        @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?        @db.Text
  receivedAt     DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  branch    Branch           @relation(fields: [branchId], references: [id])
  supplier  Supplier         @relation(fields: [supplierId], references: [id])
  createdBy User             @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items     PurchaseItem[]
  batches   Batch[]
  returns   PurchaseReturn[]

  @@index([purchaseNumber])
  @@index([supplierId])
  @@map("purchases")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  INVOICED
  CANCELLED
}

model PurchaseItem {
  id                String    @id @default(cuid())
  purchaseId        String
  productId         String
  batchId           String?
  orderedQuantity   Int
  receivedQuantity  Int       @default(0)
  freeQuantity      Int       @default(0)
  unitCost          Decimal   @db.Decimal(12, 2)
  mrp               Decimal   @db.Decimal(12, 2)
  ptr               Decimal?  @db.Decimal(12, 2)
  discountPercent   Decimal   @default(0) @db.Decimal(5, 2)
  taxPercent        Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal   @db.Decimal(12, 2)
  batchNumber       String?
  expiryDate        DateTime?
  manufacturingDate DateTime?
  createdAt         DateTime  @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch?   @relation(fields: [batchId], references: [id])

  @@map("purchase_items")
}

model PurchaseReturn {
  id           String               @id @default(cuid())
  returnNumber String               @unique
  purchaseId   String
  supplierId   String
  returnDate   DateTime             @default(now())
  reason       String
  totalAmount  Decimal              @db.Decimal(12, 2)
  status       PurchaseReturnStatus @default(PENDING)
  notes        String?              @db.Text
  createdAt    DateTime             @default(now())

  purchase Purchase             @relation(fields: [purchaseId], references: [id])
  supplier Supplier             @relation(fields: [supplierId], references: [id])
  items    PurchaseReturnItem[]

  @@map("purchase_returns")
}

enum PurchaseReturnStatus {
  PENDING
  APPROVED
  DISPATCHED
  COMPLETED
  CANCELLED
}

model PurchaseReturnItem {
  id               String  @id @default(cuid())
  purchaseReturnId String
  productId        String
  batchId          String?
  quantity         Int
  unitCost         Decimal @db.Decimal(12, 2)
  totalAmount      Decimal @db.Decimal(12, 2)
  reason           String?

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@map("purchase_return_items")
}

// ─────────────────────────────────────────────────────────────
// MODULE 10: RETURNS MANAGEMENT
// ─────────────────────────────────────────────────────────────

model SaleReturn {
  id            String           @id @default(cuid())
  returnNumber  String           @unique
  saleId        String
  customerId    String?
  returnDate    DateTime         @default(now())
  reason        String
  totalAmount   Decimal          @db.Decimal(12, 2)
  status        SaleReturnStatus @default(PENDING)
  refundMethod  PaymentMethod?
  refundRef     String?
  notes         String?          @db.Text
  processedById String?
  createdAt     DateTime         @default(now())

  sale       Sale             @relation(fields: [saleId], references: [id])
  customer   Customer?        @relation(fields: [customerId], references: [id])
  items      SaleReturnItem[]
  creditNote CreditNote?

  @@map("sale_returns")
}

enum SaleReturnStatus {
  PENDING
  APPROVED
  REFUNDED
  CREDITED
  REJECTED
}

model SaleReturnItem {
  id              String          @id @default(cuid())
  saleReturnId    String
  saleItemId      String
  quantity        Int
  unitPrice       Decimal         @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  restockDecision RestockDecision @default(RESTOCK)
  batchId         String?

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@map("sale_return_items")
}

enum RestockDecision {
  RESTOCK
  QUARANTINE
  DAMAGE_WRITE_OFF
}

model CreditNote {
  id           String           @id @default(cuid())
  noteNumber   String           @unique
  saleReturnId String           @unique
  customerId   String?
  amount       Decimal          @db.Decimal(12, 2)
  balanceUsed  Decimal          @default(0) @db.Decimal(12, 2)
  status       CreditNoteStatus @default(ACTIVE)
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])

  @@map("credit_notes")
}

enum CreditNoteStatus {
  ACTIVE
  PARTIALLY_USED
  FULLY_USED
  EXPIRED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
// MODULE 11 & 12: CUSTOMER & SUPPLIER MANAGEMENT
// ─────────────────────────────────────────────────────────────

model Customer {
  id                 String   @id @default(cuid())
  name               String
  phone              String?
  email              String?
  gstin              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  creditLimit        Decimal  @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  creditDays         Int      @default(0)
  customerType       CustomerType @default(RETAIL)
  isActive           Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sales         Sale[]
  payments      Payment[]
  saleReturns   SaleReturn[]
  creditNotes   CreditNote[]
  ledgerEntries CustomerLedger[]
  prescriptions Prescription[]   @relation("PrescriptionCustomer")

  @@index([phone])
  @@index([name])
  @@map("customers")
}

model CustomerLedger {
  id            String          @id @default(cuid())
  customerId    String
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2)
  balance       Decimal         @db.Decimal(12, 2) // Running balance
  referenceType String?
  referenceId   String?
  description   String
  entryDate     DateTime        @default(now())
  createdAt     DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, entryDate])
  @@map("customer_ledgers")
}

model Supplier {
  id                 String   @id @default(cuid())
  name               String
  contactPerson      String?
  phone              String?
  email              String?
  gstin              String?
  pan                String?
  dlNumber           String? // Drug license
  address            String?
  city               String?
  state              String?
  pincode            String?
  bankName           String?
  bankAccount        String?
  bankIfsc           String?
  creditDays         Int      @default(30)
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive           Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  payments        Payment[]
  ledgerEntries   SupplierLedger[]

  @@index([name])
  @@map("suppliers")
}

model SupplierLedger {
  id            String          @id @default(cuid())
  supplierId    String
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2)
  balance       Decimal         @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  description   String
  entryDate     DateTime        @default(now())
  createdAt     DateTime        @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, entryDate])
  @@map("supplier_ledgers")
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

// ─────────────────────────────────────────────────────────────
// MODULE 13: FINANCIAL MANAGEMENT
// ─────────────────────────────────────────────────────────────

model Ledger {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  type      LedgerType
  parentId  String?
  isSystem  Boolean    @default(false)
  balance   Decimal    @default(0) @db.Decimal(15, 2)
  createdAt DateTime   @default(now())

  parent   Ledger?       @relation("LedgerTree", fields: [parentId], references: [id])
  children Ledger[]      @relation("LedgerTree")
  entries  LedgerEntry[]

  @@map("ledgers")
}

enum LedgerType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model LedgerEntry {
  id            String          @id @default(cuid())
  ledgerId      String
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(15, 2)
  balance       Decimal         @db.Decimal(15, 2)
  description   String
  referenceType String?
  referenceId   String?
  entryDate     DateTime        @default(now())
  createdAt     DateTime        @default(now())

  ledger Ledger @relation(fields: [ledgerId], references: [id])

  @@index([ledgerId, entryDate])
  @@map("ledger_entries")
}

// ─────────────────────────────────────────────────────────────
// MODULE 14: GST & TAX MANAGEMENT
// ─────────────────────────────────────────────────────────────

model HsnCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  gstRate     Decimal  @db.Decimal(5, 2)
  cgstRate    Decimal  @db.Decimal(5, 2)
  sgstRate    Decimal  @db.Decimal(5, 2)
  igstRate    Decimal  @db.Decimal(5, 2)
  cessRate    Decimal  @default(0) @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]

  @@map("hsn_codes")
}

model TaxRate {
  id        String   @id @default(cuid())
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  cgst      Decimal  @db.Decimal(5, 2)
  sgst      Decimal  @db.Decimal(5, 2)
  igst      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("tax_rates")
}

model GstTransaction {
  id              String    @id @default(cuid())
  branchId        String
  type            GstTxType
  referenceType   String // "SALE" or "PURCHASE"
  referenceId     String
  referenceLineId String // SaleItem.id or PurchaseItem.id — line-level identity for uniqueness
  invoiceNumber   String
  invoiceDate     DateTime
  partyGstin      String?
  partyName       String?
  partyState      String?
  hsnCode         String?
  taxableAmount   Decimal   @db.Decimal(12, 2)
  cgstAmount      Decimal   @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal   @default(0) @db.Decimal(12, 2)
  igstAmount      Decimal   @default(0) @db.Decimal(12, 2)
  totalTax        Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal   @db.Decimal(12, 2)
  returnPeriod    String? // "MM-YYYY"
  isFiled         Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@unique([referenceType, referenceId, referenceLineId])
  @@index([branchId, invoiceDate])
  @@index([returnPeriod])
  @@map("gst_transactions")
}

enum GstTxType {
  B2B // Business to business
  B2C // Business to consumer
  EXPORT
  NIL_RATED
}

// ─────────────────────────────────────────────────────────────
// MODULE 17: NOTIFICATIONS & ALERTS
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  LOW_STOCK
  EXPIRY_ALERT
  PURCHASE_DUE
  PAYMENT_DUE
  PRESCRIPTION_PENDING
  SYSTEM
  INFO
}

model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  lowStock    Boolean  @default(true)
  expiry      Boolean  @default(true)
  payment     Boolean  @default(true)
  system      Boolean  @default(true)
  emailAlerts Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────────────────
// MODULE 18: FILE MANAGEMENT
// ─────────────────────────────────────────────────────────────

model File {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  size         Int // bytes
  url          String
  path         String?
  uploadedById String?
  entityType   String? // "prescription", "product", etc.
  entityId     String?
  createdAt    DateTime @default(now())

  stockAdjustmentEvidence StockAdjustment[] @relation("AdjustmentEvidence")

  @@index([entityType, entityId])
  @@map("files")
}

// ─────────────────────────────────────────────────────────────
// MODULE 19: AUDIT & COMPLIANCE
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // "CREATE", "UPDATE", "DELETE", "LOGIN", etc.
  entity    String // "Product", "Sale", "User", etc.
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// MODULE 20: SYSTEM CONFIGURATION
// ─────────────────────────────────────────────────────────────

model SystemSetting {
  id        String   @id @default(cuid())
  category  String // "pos", "inventory", "notifications", "general"
  key       String
  value     String   @db.Text
  dataType  String   @default("string") // "string", "number", "boolean", "json"
  label     String?
  updatedAt DateTime @updatedAt

  @@unique([category, key])
  @@map("system_settings")
}

// -------------------------------------------------------------
// SPRINT 1: STATUTORY COMPLIANCE & MASTERS
// -------------------------------------------------------------

model Doctor {
  id             String               @id @default(cuid())
  name           String
  registrationNo String               @unique
  mciNumber      String? // MCI registration number
  specialization String?
  clinicName     String?
  clinicAddress  String?
  phone          String?
  email          String?
  isActive       Boolean              @default(true)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  prescriptions  Prescription[]
  scheduleH1Logs ScheduleH1Register[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([registrationNo])
  @@index([name])
  @@map("doctors")
}

model ScheduleH1Register {
  id             String   @id @default(cuid())
  saleId         String
  productId      String
  batchId        String
  patientName    String
  patientAddress String
  patientPhone   String?
  doctorName     String
  doctorRegNo    String
  medicineName   String
  batchNumber    String
  quantityGiven  Int // In base units (tablets)
  dispensedDate  DateTime @default(now())
  createdById    String
  sale           Sale     @relation(fields: [saleId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
  batch          Batch    @relation(fields: [batchId], references: [id])
  createdBy      User     @relation(fields: [createdById], references: [id])
  doctor         Doctor?  @relation(fields: [doctorRegNo], references: [registrationNo])

  @@index([dispensedDate])
  @@index([doctorRegNo])
  @@index([patientPhone])
  @@map("schedule_h1_register")
}

model NarcoticRegister {
  id              String               @id @default(cuid())
  branchId        String
  productId       String
  batchId         String
  movementType    NarcoticMovementType
  quantityIn      Int                  @default(0)
  quantityOut     Int                  @default(0)
  balanceQuantity Int
  referenceType   String
  referenceId     String
  patientName     String?
  doctorName      String?
  doctorRegNo     String?
  prescriptionNo  String?
  entryDate       DateTime             @default(now())
  enteredById     String
  branch          Branch               @relation(fields: [branchId], references: [id])
  product         Product              @relation(fields: [productId], references: [id])
  enteredBy       User                 @relation(fields: [enteredById], references: [id])

  @@unique([referenceType, referenceId, productId, batchId])
  @@index([branchId, entryDate])
  @@index([productId])
  @@index([branchId, productId, entryDate])
  @@map("narcotic_register")
}

enum NarcoticMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  SALES_DISPENSE
  RETURN_TO_SUPPLIER
  DESTRUCTION
}

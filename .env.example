# ============================================================
# PharmaCare — Environment Variables Template
# Copy this file to .env.local and fill in the values
# ============================================================

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="PharmaCare"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Database ───────────────────────────────────────────────
# Local PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/pharmacare_dev?schema=public"
# For Prisma migrations
SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/pharmacare_shadow?schema=public"

# ─── NextAuth ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (for password reset, notifications) ──────────────
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@pharmacare.local"

# ─── File Storage ───────────────────────────────────────────
# Local storage path (relative to project root)
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB=10

# ─── Security ───────────────────────────────────────────────
# JWT secret for API tokens (if used outside NextAuth)
JWT_SECRET="your-jwt-secret-here"
BCRYPT_ROUNDS=12
# Dedicated key for TOTP secret encryption (AES-256-GCM). Required for MFA.
# Generate with: openssl rand -hex 32. Never reuse NEXTAUTH_SECRET here.
MFA_ENCRYPTION_KEY="your-mfa-encryption-key-here"

# ─── Optional: Error Monitoring ─────────────────────────────
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ─── Optional: Analytics ────────────────────────────────────
# POSTHOG_KEY=

# ─── EOD WhatsApp Report ─────────────────────────────────────
# Secret to protect POST /api/eod/send from public access
EOD_REPORT_SECRET="your-random-secret-here"
# Meta Cloud API (credentials set via Settings UI or here for reference)
META_WA_PHONE_NUMBER_ID="your-phone-number-id"
META_WA_BUSINESS_ACCOUNT_ID="your-waba-id"
# META_WA_ACCESS_TOKEN="your-access-token"  # Stored in DB via Settings UI

